<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>

  <xacro:macro name="robot_cell" params="
    parent
    *origin
    ur_type
    tf_prefix
    joint_limits_parameters_file
    kinematics_parameters_file
    physical_parameters_file
    visual_parameters_file
    ">

    <joint name="table_base_joint" type="fixed">
      <xacro:insert_block name="origin" />
      <parent link="${parent}" />
      <child link="table" />
    </joint>

    <link name="table">
      <visual>
      <origin xyz="0 0 -0.5" rpy="0 0 0"/>
      <geometry>
        <box size="0.8 0.8 1.0"/>
      </geometry>
      <material name="brown">
        <color rgba="0.5 0.3 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.5" rpy="0 0 0"/>
      <geometry>
        <box size="0.8 0.8 1.0"/>
      </geometry>
    </collision>
    </link>

    <link name="robot_mount"/>
    <joint name="base_to_robot_mount" type="fixed">
      <parent link="table"/>
      <child link="robot_mount"/>
      <origin xyz="0 0 1.0" rpy="0 0 0" />
    </joint>

    <!--This will create the specific robot-->
    <xacro:ur_robot
      name="${ur_type}"
      tf_prefix="${ur_type}_"
      parent="robot_mount"
      joint_limits_parameters_file="${joint_limits_parameters_file}"
      kinematics_parameters_file="${kinematics_parameters_file}"
      physical_parameters_file="${physical_parameters_file}"
      visual_parameters_file="${visual_parameters_file}"
    >
      <origin xyz="0 0 0" rpy="0 0 0" />
    </xacro:ur_robot>

    <link name="pen_link">
     <visual>
       <origin xyz="0 0 0.135" rpy="0 0 0"/>
       <geometry>
         <cylinder radius="0.1" length="0.270"/>
       </geometry>
       <material name="blue">
         <color rgba="0.2 0.2 0.8 1.0"/>
       </material>
     </visual>
     <collision>
       <origin xyz="0 0 0.135" rpy="0 0 0"/>
       <geometry>
         <cylinder radius="0.1" length="0.27"/>
       </geometry>
     </collision>
   </link>


   <joint name="pen_fixed_joint" type="fixed">
     <parent link="ur5_tool0"/>
     
     <child  link="pen_link"/>
     <!-- ajustez xyz/rpy pour que le stylo corresponde à la réalité -->
     <origin xyz="0 0 0" rpy="0 0 0"/>
   </joint>


  </xacro:macro>

</robot>